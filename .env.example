# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM (expense parsing + natural-language Q&A) — Groq's free tier, same
# account/key as speech-to-text below. Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Speech-to-text
# groq: free tier (2,000 requests/day), no credit card, no org registration. Recommended.
# google: no org registration, but needs a Google Cloud billing account.
# bhashini: free and strong on Telugu, but requires org registration to get API access.
STT_PROVIDER=groq
GOOGLE_STT_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_PIPELINE_ID=

# Site URL used for Supabase auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional overrides — every value below already has a working default in
# src/lib/config.ts. Uncomment and set one only if you need to point at a
# different model/endpoint/tuning value than the default.
# GROQ_CHAT_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GROQ_TRANSCRIPTION_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# LLM_TEMPERATURE=0
# LLM_MAX_TOOL_TURNS=4
# GOOGLE_STT_ENDPOINT=https://speech.googleapis.com/v1/speech:recognize
# GOOGLE_STT_ENCODING=WEBM_OPUS
# GOOGLE_STT_SAMPLE_RATE=48000
# BHASHINI_ASR_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_COMPUTE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# BHASHINI_SAMPLE_RATE=16000
